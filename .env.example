# ==============================================================================
# Cyclone Preparedness Assistant — Environment Configuration
# Copy this file to '.env' and customize for deployment.
# Do NOT commit '.env' containing private secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Host Exposed Ports
# ------------------------------------------------------------------------------
API_PORT=8000
DASHBOARD_PORT=8501

# ------------------------------------------------------------------------------
# FastAPI Backend & Model Configuration
# ------------------------------------------------------------------------------
# W&B Model Artifact Version or Alias (e.g. 'village-preparedness-classifier:v0')
WANDB_MODEL_ARTIFACT=village-preparedness-classifier:v0

# W&B Project & Entity Lineage
WANDB_PROJECT=cyclone-preparedness-assistant
WANDB_ENTITY=bhavanishreddy69-na

# Optional Weights & Biases API Key (only required if pulling uncached artifacts)
WANDB_API_KEY=

# Internal Container Cache and Monitoring Storage Paths
WANDB_CACHE_DIR=/app/.wandb_artifacts_cache
MONITORING_REPORTS_DIR=/app/reports/model_monitoring

# ------------------------------------------------------------------------------
# Streamlit Dashboard Configuration
# ------------------------------------------------------------------------------
# Adapter mode: 'rest' (FastAPI HTTP REST communication) or 'direct' (in-memory)
CYCLONE_ADAPTER_MODE=rest

# Internal Docker Network Service URL for API
CYCLONE_API_BASE_URL=http://api:8000
API_BASE_URL=http://api:8000

# API Client Timeout in Seconds
CYCLONE_API_TIMEOUT=15.0

# ------------------------------------------------------------------------------
# Conversational LLM Assistant Configuration
# ------------------------------------------------------------------------------
# Primary Provider: 'openrouter' or 'gemini'
LLM_PROVIDER=openrouter

# OpenRouter API (Primary Conversational Provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=30.0

# Google Gemini API (Alternative Provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_SECONDS=30.0

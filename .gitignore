# Model Checkpoints & Large Binaries (>50-100MB GitHub limit)
# Note: Tokenizers (vocab.json), configs (config.yaml), metadata (provenance.json),
# evaluation reports (*.json), and training summaries are tracked.
*.pt
*.pth
*.bin
*.onnx

# Binary model files: ignore large dumps but allowlist production artifacts & intent models
*.joblib
!models/logistic_regression_tier.joblib
!models/label_encoder.joblib
!models/render_artifact/*.joblib
!models/cyclonelm/v0.8/intent/*.joblib

# Local logs, scratch, backups, and Colab exports
logs/
scratch/
backups/
export/

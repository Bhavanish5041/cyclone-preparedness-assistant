# ==============================================================================
# Streamlit Dashboard Production Container
# Cyclone Preparedness Decision Support System
# ==============================================================================

FROM python:3.14-slim

LABEL maintainer="Cyclone Preparedness Team"
LABEL description="Streamlit decision-support dashboard frontend"

# Environment configuration
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8501 \
    CYCLONE_ADAPTER_MODE="rest" \
    CYCLONE_API_BASE_URL="http://api:8000" \
    API_BASE_URL="http://api:8000" \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_ADDRESS="0.0.0.0" \
    STREAMLIT_SERVER_HEADLESS="true" \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS="false"

# Install system dependencies (curl for container healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root system user and group
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /bin/bash -m appuser

WORKDIR /app

# Install pinned Python dependencies
COPY docker/requirements-dashboard.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code and processed data
COPY src/ /app/src/
COPY data/processed/ /app/data/processed/

# Setup home and config directory for non-root user
RUN mkdir -p /home/appuser/.streamlit && \
    chown -R appuser:appgroup /app /home/appuser

# Switch to unprivileged user
USER appuser

# Expose Streamlit frontend port
EXPOSE 8501

# Container healthcheck using Streamlit native health route
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Graceful shutdown signal
STOPSIGNAL SIGTERM

# Start Streamlit application
CMD ["streamlit", "run", "src/assistant/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]

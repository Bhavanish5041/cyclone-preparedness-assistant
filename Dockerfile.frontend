# ==============================================================================
# React + Vite Frontend Production Container (Multi-Stage Build)
# Cyclone Preparedness Decision Support System
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build React SPA
# ------------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app/frontend

# Install dependencies using lockfile and .npmrc
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci

# Copy frontend source code and configuration
COPY frontend/ ./

# Build production assets (emits to /app/frontend/dist)
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Production Nginx Server
# ------------------------------------------------------------------------------
FROM nginx:alpine

LABEL maintainer="Cyclone Preparedness Team"
LABEL description="Nginx web server and reverse proxy for React SPA"

# Copy built production frontend assets from builder stage
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

# Copy container-optimized Nginx reverse proxy configuration
COPY deployment/nginx/nginx.container.conf /etc/nginx/nginx.conf

# Security permissions for nginx non-root execution
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /usr/share/nginx/html

# Expose HTTP port 80
EXPOSE 80

# Healthcheck
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q --spider http://localhost:80/ || exit 1

STOPSIGNAL SIGQUIT

CMD ["nginx", "-g", "daemon off;"]
